{
  "name": "whitecabz-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build": "npm install --prefix apps/web && npm --prefix apps/web run build && npm install --prefix apps/api",
    "start": "npm --prefix apps/api start",
    "start:api": "npm --prefix apps/api start",
    "render:build": "npm install --prefix apps/web && npm --prefix apps/web run build && npm install --prefix apps/api",
    "render:start": "npm --prefix apps/api start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "uuid": "^11.1.1"
  }
}